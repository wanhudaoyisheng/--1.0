# 《词钥》API 服务 · 环境变量示例
# 复制为 .env 后按需修改；.env 不要提交到代码库。

# 运行环境：development | production | test
NODE_ENV=development

# 监听地址与端口
HOST=0.0.0.0
PORT=8787

# SQLite 数据库文件路径（相对工程根目录）
DB_FILE=var/ciyue.db

# 允许的跨域来源，逗号分隔；开发期可用 * 反射来源，生产环境必须写显式域名
# 例如：https://ciyue.example.com,https://www.ciyue.example.com
CORS_ORIGINS=

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 静态前端目录（由 API 服务一并托管，同源即免跨域）
STATIC_DIR=public

# 每个会话每分钟最多提交多少次判定（防暴力穷举关键词）
ATTEMPT_RATE_LIMIT=60

# ---------- 后续接入真实大模型时再填（当前版本不读取） ----------
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
